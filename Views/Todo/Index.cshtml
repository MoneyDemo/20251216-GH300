@model IEnumerable<TodoDemo.Models.Todo>

@{
    ViewData["Title"] = "TODO List";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="display-4">📝 My TODO List</h1>
            <p class="lead">Manage your tasks efficiently</p>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-12">
            <a asp-action="Create" class="btn btn-primary btn-lg">
                <i class="bi bi-plus-circle"></i> Add New Task
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info" role="alert">
            <h4 class="alert-heading">No tasks yet!</h4>
            <p>Start by adding your first TODO item.</p>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-12">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th style="width: 5%">Status</th>
                                    <th style="width: 30%">Title</th>
                                    <th style="width: 40%">Description</th>
                                    <th style="width: 15%">Created</th>
                                    <th style="width: 10%">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr class="@(item.IsCompleted ? "table-success" : "")">
                                        <td>
                                            <form asp-action="Toggle" asp-route-id="@item.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm @(item.IsCompleted ? "btn-success" : "btn-outline-secondary")" title="Toggle completion">
                                                    @if (item.IsCompleted)
                                                    {
                                                        <i class="bi bi-check-circle-fill"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-circle"></i>
                                                    }
                                                </button>
                                            </form>
                                        </td>
                                        <td>
                                            @if (item.IsCompleted)
                                            {
                                                <span class="text-decoration-line-through text-muted">@item.Title</span>
                                            }
                                            else
                                            {
                                                <strong>@item.Title</strong>
                                            }
                                        </td>
                                        <td>
                                            @if (item.IsCompleted)
                                            {
                                                <span class="text-decoration-line-through text-muted">@item.Description</span>
                                            }
                                            else
                                            {
                                                @item.Description
                                            }
                                        </td>
                                        <td>
                                            <small class="text-muted">@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this task?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-md-12">
                <div class="alert alert-light d-flex justify-content-between align-items-center" role="alert">
                    <span>
                        <strong>Total:</strong> @Model.Count() tasks |
                        <strong>Completed:</strong> @Model.Count(t => t.IsCompleted) |
                        <strong>Pending:</strong> @Model.Count(t => !t.IsCompleted)
                    </span>
                </div>
            </div>
        </div>
    }
</div>
